# Vinta School OS — frontend environment variables
#
# Copy this file to `.env` for local development.
#
# NOTE: Vite reads these at BUILD time and bakes the values into the JavaScript.
# Changing VITE_API_URL on Vercel does nothing until you trigger a redeploy.

# Local development: the Vite dev server proxies /api to http://localhost:5000
# (see the `server.proxy` block in vite.config.ts).
VITE_API_URL=/api

# Production (set this in the Vercel dashboard instead of committing it):
# VITE_API_URL=https://your-backend.onrender.com/api

VITE_APP_NAME=Vinta School OS
VITE_APP_VERSION=1.0.0
