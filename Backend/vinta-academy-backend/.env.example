# Vinta School OS — backend environment variables
#
# Copy to `.env` for local development, and set the same keys in the Render
# dashboard for production. Never commit the real `.env`.

# development | production
FLASK_ENV=development

# Generate each of these with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# They MUST be different in production, and MUST NOT be the dev values.
SECRET_KEY=replace-me
JWT_SECRET_KEY=replace-me

# SQLAlchemy URL. Local MySQL shown; production uses the Aiven URL, which
# needs the `+pymysql` driver prefix added to what Aiven gives you.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/vinta_school_dev

# Comma-separated list of frontend origins allowed to call the API.
# Production example:
#   CORS_ORIGINS=https://vinta-school-os.vercel.app
CORS_ORIGINS=http://localhost:5137

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
